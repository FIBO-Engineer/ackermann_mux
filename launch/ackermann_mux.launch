<launch>
  <arg name="ackermann_vel_out" default="ackermann_mux/ackermann_vel"/>

  <arg name="config_locks"  default="$(find ackermann_mux)/config/ackermann_mux_locks.yaml"/>
  <arg name="config_topics" default="$(find ackermann_mux)/config/ackermann_mux_topics.yaml"/>

  <node pkg="ackermann_mux" type="ackermann_mux" name="ackermann_mux" output="screen">
    <remap from="ackermann_vel_out" to="$(arg ackermann_vel_out)"/>

    <rosparam file="$(arg config_locks)"  command="load"/>
    <rosparam file="$(arg config_topics)" command="load"/>
  </node>

  <node pkg="ackermann_mux" type="twist_marker" name="twist_marker">
    <remap from="twist"  to="$(arg ackermann_vel_out)"/>
    <remap from="marker" to="twist_marker"/>
  </node>
</launch>

